---
import site from '../content/settings.json';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="hdr">
	<a class="hdr__logo" href="/" aria-label={`${site.name} — home`}>
		<img src="/images/logo-primary.png" alt={site.name} width="3071" height="863" />
	</a>

	<nav class="hdr__nav" aria-label="Main">
		{
			site.nav.map((item) => (
				<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>

	<div class="hdr__actions">
		<a class="btn" href={site.headerCta.href}>{site.headerCta.label}</a>
		<button class="burger" type="button" aria-label="Open menu" aria-expanded="false">
			<span></span><span></span><span></span>
		</button>
	</div>
</header>
