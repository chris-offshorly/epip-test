---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Page not found"
	description="The page you were looking for doesn't exist. Head back to the Epiphanies homepage."
>
	<section>
		<div class="hero hero--sub">
			<div class="hero__text">
				<p class="eyebrow">404</p>
				<h1 class="h1">We can&rsquo;t find that page</h1>
				<div>
					<p class="lede">
						The link may be out of date, or the page may have moved.
					</p>
					<p class="p">
						You could start again from the homepage, or tell us what you were looking for and
						we&rsquo;ll point you in the right direction.
					</p>
				</div>
				<div class="hero__cta" style="display:flex;gap:12px;flex-wrap:wrap">
					<a class="btn solid" href="/">Back to the homepage</a>
					<a class="btn" href="/contact">Get in touch</a>
				</div>
			</div>
			<div class="hero__media">
				<img
					src="/images/home-header.webp"
					alt="Looking up into the curved atrium of a modern building against a blue sky"
					width="1600"
					height="1067"
				/>
			</div>
		</div>
	</section>
</BaseLayout>
